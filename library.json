{
    "name": "DigitalDoorKey",
    "version": "1.0.1",
    "license": "MIT",
    "frameworks": [
        "arduino"
    ],
    "platforms": [
        "espressif32"
    ],
    "build": {
        "srcFilter": [
            "+<*>",
            "-<aliro/>",
            "-<auth/Aliro*>",
            "-<crypto/GcmSecureChannel.cpp>",
            "-<utils/BerTlv.cpp>",
            "-<transport/Ble*>"
        ],
        "extraScript": "platformio.py"
    }
}
